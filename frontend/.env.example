# Copy this file to .env and adjust for your environment.
# Falls back to http://127.0.0.1:8000/api if unset.
VITE_API_BASE=http://127.0.0.1:8000/api

# Optional. Google OAuth Client ID for "Sign in with Google" -- must be the
# SAME value as the backend's GOOGLE_CLIENT_ID. Get one free at
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# OAuth client ID -> Web application (add http://localhost:5173 as an
# authorized JavaScript origin). Leave blank to keep the Google button
# showing an honest "not configured" message instead of failing silently.
VITE_GOOGLE_CLIENT_ID=
