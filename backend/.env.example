# Copy this file to .env and adjust for your environment.
# All of these have safe dev-friendly defaults if left unset.

# Set a real, secret value in production.
DJANGO_SECRET_KEY=dev-secret-key-change-me

# "true" for local development, "false" in production.
DJANGO_DEBUG=true

# Comma-separated hostnames. Required (non-"*") once DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=

# Comma-separated frontend origins allowed to call this API. Defaults to
# the Vite dev server origins if unset.
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated origins Django trusts for state-changing requests (e.g.
# admin login) over HTTPS. Required once DJANGO_DEBUG=false, e.g.
# "https://medway-api.onrender.com".
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional. Postgres connection string (e.g. from a free Neon/Supabase
# project) -- required on any host with an ephemeral filesystem, since a
# local sqlite file there gets wiped on every redeploy/restart. Leave
# blank to use the local sqlite file.
DATABASE_URL=

# Optional but STRONGLY recommended in production. Free Google Gemini API
# key, used by the Medicine Info assistant's free-text understanding
# ("loose motion" -> Diarrhea) AND the prescription photo reader. Get one
# free, no credit card, at https://aistudio.google.com/apikey. Leave blank
# to skip both -- the assistant falls back to plain keyword matching, and
# prescription photos fall back to local EasyOCR (only installed if you
# `pip install easyocr` yourself; deliberately excluded from
# requirements.txt since it pulls in torch/opencv, too heavy for most free
# hosting tiers).
GEMINI_API_KEY=

# Optional. xAI Grok API key, from console.x.ai (requires billing, no
# free tier). Used only by the Medicine Info page's "Talk to AI doctor"
# voice consult, as a second attempt if Gemini's call fails or its
# free-tier quota is exhausted. Leave blank to skip straight to that
# feature's deterministic fallback script when Gemini fails.
GROK_API_KEY=

# Optional. Google OAuth Client ID for "Sign in with Google", from
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# OAuth client ID -> Web application. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (same value, both sides). Leave blank to disable --
# the Google button will show a clear "not configured" message instead.
GOOGLE_CLIENT_ID=

# Pharmacy-side portal integration. Base URL of the pharmacy backend and an
# API key created there via `python manage.py seed_integration_key`. Used
# by `python manage.py sync_pharmacy_data` to pull real inventory into
# this portal's MedicineStock/PriceLog tables.
PHARMACY_API_BASE_URL=http://127.0.0.1:8001
PHARMACY_API_KEY=
