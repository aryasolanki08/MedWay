# Copy this file to .env and adjust for your environment.

# Base URL of the pharmacy backend API. Defaults to http://127.0.0.1:8001
# if unset (see src/utils/api.js).
VITE_API_BASE=http://127.0.0.1:8001

# Optional. Google OAuth Client ID for "Sign in with Google", same value
# as the backend's GOOGLE_CLIENT_ID. Can reuse the customer portal's
# client ID if this app's origin (e.g. http://localhost:5174) is also
# added as an authorized JavaScript origin on that OAuth client. Leave
# blank to disable -- the Google button shows a clear "not configured"
# message instead.
VITE_GOOGLE_CLIENT_ID=
