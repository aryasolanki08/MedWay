# Copy this file to .env and adjust for your environment.
# All of these have safe dev-friendly defaults if left unset.

# Set a real, secret value in production.
DJANGO_SECRET_KEY=dev-secret-key-change-me

# "true" for local development, "false" in production.
DJANGO_DEBUG=true

# Comma-separated hostnames. Required (non-"*") once DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=

# Comma-separated frontend origins allowed to call this API. Defaults to
# the Vite dev server origin if unset.
DJANGO_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Comma-separated origins Django trusts for state-changing requests (e.g.
# admin login) over HTTPS. Required once DJANGO_DEBUG=false, e.g.
# "https://medway-pharmacy-api.onrender.com".
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional. Postgres connection string (e.g. from a free Neon/Supabase
# project) -- required on any host with an ephemeral filesystem, since a
# local sqlite file there gets wiped on every redeploy/restart. Leave
# blank to use the local sqlite file.
DATABASE_URL=

# Optional. Google OAuth Client ID for "Sign in with Google", from
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# OAuth client ID -> Web application. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (same value, both sides). Can reuse the same
# client ID as the customer portal if both origins are authorized on it.
# Leave blank to disable -- the Google button shows a clear "not
# configured" message instead.
GOOGLE_CLIENT_ID=

# Customer-portal integration. Base URL of the customer backend and an API
# key generated here via `python manage.py seed_integration_key` -- paste
# that same printed key into the customer backend's .env as
# PHARMACY_API_KEY. Used by the customer portal's `sync_pharmacy_data`/
# `push_catalog_to_pharmacy` commands and by live order routing between
# the two portals.
CUSTOMER_API_BASE_URL=http://127.0.0.1:8000
CUSTOMER_API_KEY=

# Razorpay test-mode keys. Leave as placeholders to keep order/subscription
# payments in mock mode (see accounts/views.py's is_mock convention).
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=placeholder_secret
